<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Capsule Stash Alfred 워크플로 (T-54). `cs <검색어>` → Enter 복사 · ⌘Enter 앱에서 열기.
  스키마 주의: Run Script config `type`은 언어 열거형 (0=bash) — 없는 값을 넣으면
  Alfred가 "incompatible workflow"로 찍는다 (2026-10-04 실측, type:2 → 불가).
  Script Filter는 argv 모드(`$1`)라 따옴표 이스케이프 걱정이 없다.
-->
<plist version="1.0">
<dict>
	<key>bundleid</key>
	<string>com.borasarang.capsulestash</string>
	<key>category</key>
	<string>Tools</string>
	<key>createdby</key>
	<string>BoraSarang</string>
	<key>name</key>
	<string>Capsule Stash</string>
	<key>description</key>
	<string>메뉴바 지식 저장소 검색·복사 (cs 키워드, ⌘Enter 앱 열기)</string>
	<key>disabled</key>
	<false/>
	<key>version</key>
	<string>0.5.0</string>
	<key>webaddress</key>
	<string>https://github.com/BoraSarang/CapsuleStash</string>
	<key>readme</key>
	<string>cs &lt;검색어&gt; → Enter 복사 · ⌘Enter 앱에서 열기. 계정 블록은 홈페이지·아이디만 복사된다.</string>
	<key>variablesdontexport</key>
	<array/>
	<key>objects</key>
	<array>
		<dict>
			<key>uid</key>
			<string>CS-KEYWORD-001</string>
			<key>type</key>
			<string>input.keyword</string>
			<key>version</key>
			<integer>1</integer>
			<key>config</key>
			<dict>
				<key>argumenttype</key>
				<integer>0</integer>
				<key>keyword</key>
				<string>cs</string>
				<key>subtext</key>
				<string>Capsule Stash 검색</string>
				<key>text</key>
				<string>cs</string>
				<key>withspace</key>
				<true/>
			</dict>
		</dict>
		<dict>
			<key>uid</key>
			<string>CS-FILTER-001</string>
			<key>type</key>
			<string>alfred.workflow.input.scriptfilter</string>
			<key>version</key>
			<integer>3</integer>
			<key>config</key>
			<dict>
				<key>alfredfiltersresults</key>
				<false/>
				<key>alfredfiltersresultsmatchmode</key>
				<integer>0</integer>
				<key>argumenttreatemptyqueryasnil</key>
				<false/>
				<key>argumenttrimmode</key>
				<integer>0</integer>
				<key>argumenttype</key>
				<integer>0</integer>
				<key>escaping</key>
				<integer>102</integer>
				<key>queuedelaycustom</key>
				<integer>3</integer>
				<key>queuedelayimmediatelyinitially</key>
				<true/>
				<key>queuedelaymode</key>
				<integer>0</integer>
				<key>queuemode</key>
				<integer>1</integer>
				<key>runningsubtext</key>
				<string>검색 중…</string>
				<key>script</key>
				<string>./search.py "$1"</string>
				<key>scriptargtype</key>
				<integer>1</integer>
				<key>scriptfile</key>
				<string></string>
				<key>subtext</key>
				<string></string>
				<key>title</key>
				<string>Capsule Stash 검색</string>
				<key>type</key>
				<integer>0</integer>
				<key>withspace</key>
				<true/>
			</dict>
		</dict>
		<dict>
			<key>uid</key>
			<string>CS-ACTION-001</string>
			<key>type</key>
			<string>alfred.workflow.action.script</string>
			<key>version</key>
			<integer>2</integer>
			<key>config</key>
			<dict>
				<key>concurrently</key>
				<false/>
				<key>escaping</key>
				<integer>102</integer>
				<key>script</key>
				<string>./copy-or-open.sh</string>
				<key>scriptargtype</key>
				<integer>0</integer>
				<key>scriptfile</key>
				<string></string>
				<key>type</key>
				<integer>0</integer>
			</dict>
		</dict>
	</array>
	<key>connections</key>
	<dict>
		<key>CS-KEYWORD-001</key>
		<array>
			<dict>
				<key>destinationuid</key>
				<string>CS-FILTER-001</string>
				<key>modifiers</key>
				<integer>0</integer>
				<key>modifiersubtext</key>
				<string></string>
				<key>viable</key>
				<true/>
				<key>vitoclose</key>
				<false/>
			</dict>
		</array>
		<key>CS-FILTER-001</key>
		<array>
			<dict>
				<key>destinationuid</key>
				<string>CS-ACTION-001</string>
				<key>modifiers</key>
				<integer>0</integer>
				<key>modifiersubtext</key>
				<string></string>
				<key>viable</key>
				<true/>
				<key>vitoclose</key>
				<false/>
			</dict>
		</array>
	</dict>
	<key>uidata</key>
	<dict>
		<key>CS-KEYWORD-001</key>
		<dict>
			<key>xpos</key>
			<integer>100</integer>
			<key>ypos</key>
			<integer>100</integer>
		</dict>
		<key>CS-FILTER-001</key>
		<dict>
			<key>xpos</key>
			<integer>300</integer>
			<key>ypos</key>
			<integer>100</integer>
		</dict>
		<key>CS-ACTION-001</key>
		<dict>
			<key>xpos</key>
			<integer>500</integer>
			<key>ypos</key>
			<integer>100</integer>
		</dict>
	</dict>
</dict>
</plist>
